# DeepCoral Backend - Production Environment Configuration
# 
# Copy this file to .env.production and update with your actual values
# NEVER commit this file to version control!

# =============================================================================
# ENVIRONMENT
# =============================================================================
FLASK_ENV=production
DEBUG=False

# =============================================================================
# DATABASE CONFIGURATION (AWS RDS PostgreSQL)
# =============================================================================
# Your RDS endpoint (found in AWS RDS Console)
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com

# Default PostgreSQL port
DB_PORT=5432

# Database master username (default: postgres)
DB_USER=postgres

# Database master password (set during RDS creation)
DB_PASSWORD=your-secure-rds-password

# Database name (default: deep_coral_ai)
DB_NAME=deep_coral_ai

# =============================================================================
# FLASK CONFIGURATION
# =============================================================================
# Generate a secure secret key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-generated-secret-key-here-use-64-characters

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Add your frontend domain(s) - comma-separated, no spaces
# Examples:
#   Single domain: https://deepcoral.com
#   Multiple domains: https://deepcoral.com,https://www.deepcoral.com
#   With subdomain: https://app.deepcoral.com,https://deepcoral.com
#
# For testing with local frontend: http://localhost:3000
# For production: https://your-actual-domain.com
CORS_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# =============================================================================
# SENDGRID EMAIL CONFIGURATION
# =============================================================================
# SendGrid API Key (get from https://sendgrid.com/)
# Leave empty to fetch from AWS Secrets Manager (recommended)
# Format: SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_API_KEY=

# Email address to send FROM (must be verified in SendGrid)
SENDGRID_FROM_EMAIL=noreply@deepcoral.com
SENDGRID_FROM_NAME=DeepCoral AI System

# =============================================================================
# ADMIN NOTIFICATION SETTINGS
# =============================================================================
# Admin email to receive notifications (user registrations, etc.)
ADMIN_NOTIFICATION_EMAIL=admin@deepcoral.com

# Subject line for admin notifications
ADMIN_NOTIFICATION_SUBJECT=New User Registration - DeepCoral AI

# =============================================================================
# COMPANY INFORMATION
# =============================================================================
COMPANY_NAME=DeepCoral AI
COMPANY_WEBSITE=https://deepcoral.com
SUPPORT_EMAIL=support@deepcoral.com

# =============================================================================
# RECAPTCHA (Google reCAPTCHA v2)
# =============================================================================
# reCAPTCHA Secret Key (get from https://www.google.com/recaptcha/admin)
# Leave empty to fetch from AWS Secrets Manager (recommended)
# This is automatically loaded via aws_secrets.py
# RECAPTCHA_SECRET=your-recaptcha-secret-key

# =============================================================================
# AWS CONFIGURATION (Optional - for custom configurations)
# =============================================================================
# These are automatically detected by boto3 if EC2 has IAM role attached
# Only set these if you need to override the defaults
# AWS_REGION=ap-southeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# =============================================================================
# FILE UPLOAD SETTINGS
# =============================================================================
# Maximum upload size is set in config.py (default: 200MB)
# Paths for uploaded files (relative to backend directory)
# These are automatically created by the application
# CORAL_UPLOADS_PATH=coral_uploads
# PROFILE_UPLOADS_PATH=profile_uploads
# SHARED_UPLOADS_PATH=shared_uploads

# =============================================================================
# LOGGING (Optional)
# =============================================================================
# LOG_LEVEL=INFO
# LOG_FILE=/var/log/deepcoral/backend.log

# =============================================================================
# IMPORTANT SECURITY NOTES:
# =============================================================================
# 1. NEVER commit this file to version control
# 2. Use strong, unique passwords for DB_PASSWORD
# 3. Generate a new SECRET_KEY (64+ characters)
# 4. Update CORS_ORIGINS with your actual frontend domain
# 5. Verify SENDGRID_FROM_EMAIL in SendGrid dashboard
# 6. For production, store secrets in AWS Secrets Manager
# 7. Restrict file permissions: chmod 600 .env.production

# =============================================================================
# QUICK SETUP GUIDE:
# =============================================================================
# 1. Copy this file:
#    cp .env.production.example .env.production
#
# 2. Generate SECRET_KEY:
#    python3 -c "import secrets; print(secrets.token_hex(32))"
#
# 3. Update database credentials from AWS RDS Console
#
# 4. Update CORS_ORIGINS with your frontend domain
#
# 5. Configure SendGrid API key (or use AWS Secrets Manager)
#
# 6. Set proper file permissions:
#    chmod 600 .env.production
#
# 7. Test configuration:
#    python3 -c "from config import Config; print('Config loaded successfully')"
